# Copy to `.env` in this folder and fill in absolute paths (or type them in the sidebar).

# The output root: contains one subfolder per run/strategy, each with <patient_id>.json files.
OUTPUT_DIR=/your_output_data_path

# The raw documents folder: <patient_id>.json files of { "documents": [ {docId, docText, ...} ] }.
RAW_DIR=/your_raw_document_path
ANNOTATIONS_FILE=/output_path_to_see_citations.csv