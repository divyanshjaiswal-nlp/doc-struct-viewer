# Copy to `.env` on the server and fill in absolute paths.
# These are all fixed on the server and are NOT editable in the UI — reviewers
# only type a document id at the top of the page.

# The output root: contains one subfolder per run/strategy, each with <patient_id>.json files.
OUTPUT_DIR=/your_output_data_path

# The run/strategy subfolder (a folder name inside OUTPUT_DIR) to serve to reviewers.
RUN_SUBFOLDER=your_run_name

# CSV index mapping each document to its patient. Must have a header row with
# `doc_id` and `patient_id` columns.
DOC_PATIENT_CSV=/path/to/doc_patient_index.csv

# The raw documents folder: <patient_id>.json files of { "documents": [ {docId, docText, ...} ] }.
RAW_DIR=/your_raw_document_path

# CSV where reviewer feedback (comments + corrected citations) is written.
ANNOTATIONS_FILE=/output_path_to_see_citations.csv

# --- Baseline run (for the "Compare vs baseline" page) -----------------------
# Same layout as the main output: BASELINE_OUTPUT_DIR/BASELINE_RUN_SUBFOLDER/
# <patient_id>.json. The baseline responses use the 20-section schema
# (BASELINE_SECTIONS in sections.py).
BASELINE_OUTPUT_DIR=/your_baseline_output_data_path
BASELINE_RUN_SUBFOLDER=your_baseline_run_name

# doc_id -> patient_id index for the baseline outputs (same format as
# DOC_PATIENT_CSV). If unset, the main DOC_PATIENT_CSV is used.
BASELINE_DOC_PATIENT_CSV=/path/to/baseline_doc_patient_index.csv
